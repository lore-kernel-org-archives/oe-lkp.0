+ spin_unlock(&dentry->d_lock);
+ } else {
+ spin_lock(&dentry->d_lock);
+ list_del_init(&cursor->d_child);
+ spin_unlock(&dentry->d_lock);
}
+
+ dput(to);
dput(to) should be in if if (file->f_pos > 2)? cause we dget(to) in scan_po=
sitives
