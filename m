> >  	pr_info("%s: Freed %lu RCU callbacks.\n", __func__, ncbs);
> > -	rcu_barrier();
> > +	cur_ops->cb_barrier();
> >  	ncbs =3D 0;
> >  	for (i =3D 0; i < fwd_progress; i++)
> >  		ncbs +=3D rcu_torture_fwd_prog_cbfree(&rfp[i]);
