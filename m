#!/bin/bash

kernel=3D$1
initrd=3Dyocto-minimal-x86_64.cgz

wget --no-clobber https://github.com/fengguang/reproduce-kernel-bug/blob/ma=
ster/initrd/$initrd

kvm=3D(
	qemu-system-x86_64 -cpu kvm64 -enable-kvm
 	-kernel $kernel
	-initrd $initrd
	-smp 2
	-m 256M
	-net nic,vlan=3D0,macaddr=3D00:00:00:00:00:00,model=3Dvirtio
	-net user,vlan=3D0
	-net nic,vlan=3D1,model=3De1000
	-net user,vlan=3D1
	-boot order=3Dnc
	-no-reboot
	-watchdog i6300esb
	-serial stdio
	-display none
	-monitor null
)

append=3D(
	debug
	sched_debug
	apic=3Ddebug
	ignore_loglevel
	sysrq_always_enabled
	panic=3D10
	prompt_ramdisk=3D0
	earlyprintk=3DttyS0,115200
	console=3DttyS0,115200
	console=3Dtty0
	vga=3Dnormal
	root=3D/dev/ram0
	rw
)

"${kvm[@]}" --append "${append[*]}"
